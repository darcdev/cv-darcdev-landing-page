---
import esFlag from '../../assets/flags/es.png';
import gbFlag from '../../assets/flags/gb.png';

interface Props {
  country: 'es' | 'en';
  class?: string;
}

const { country, class: className = '' } = Astro.props;
const src = country === 'es' ? esFlag.src : gbFlag.src;
---

<img class={`flag ${className}`.trim()} src={src} alt="" aria-hidden="true" />
